# Ajustes de red para conexiones lentas/inestables. No afectan las versiones
# resueltas (eso lo define pnpm-lock.yaml), solo la paciencia de pnpm al bajar
# paquetes: más tiempo de espera, más reintentos, menos descargas en paralelo.
fetch-timeout=300000
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
network-concurrency=4
