generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum Rol {
  ADMIN
  VICEDECANO
  PROFESOR
  ESTUDIANTE
}

enum Municipio {
  CIENFUEGOS
  ABREUS
  CRUCES
  CUMANAYAGUA
  LAJAS
  PALMIRA
  RODAS
  AGUADA_DE_PASAJEROS
}

enum Plan {
  D
  E
}

enum EstadoEvaluacion {
  APROBADA
  PENDIENTE
}

// ==========================================
// MODELOS
// Alcance: RF01-RF07. Invitacion y AccionCorrectiva quedan fuera de esta
// entrega (no aparecen en los RF definidos) y se documentan como roadmap
// para la tesis.
// ==========================================

model Usuario {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  nombre    String
  apellidos String
  rol       Rol
  activo    Boolean  @default(true)
  telefono  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profesor   Profesor?
  estudiante Estudiante?

  @@map("Usuario")
}

model Profesor {
  id        String   @id @default(uuid())
  usuarioId String   @unique
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  createdAt DateTime @default(now())

  asignaturas Asignatura[]

  @@map("Profesor")
}

model Estudiante {
  id              String    @id @default(uuid())
  usuarioId       String    @unique
  usuario         Usuario   @relation(fields: [usuarioId], references: [id])
  carreraId       String
  carrera         Carrera   @relation(fields: [carreraId], references: [id])
  carnetIdentidad String    @unique
  municipio       Municipio
  observaciones   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  evaluaciones Evaluacion[]

  @@map("Estudiante")
}

model Carrera {
  id        String   @id @default(uuid())
  nombre    String
  plan      Plan
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estudiantes Estudiante[]
  // Plan de estudios: asignaturas que se cursan en esta carrera.
  asignaturas Asignatura[]

  @@map("Carrera")
}

model Asignatura {
  id         String   @id @default(uuid())
  nombre     String
  semestre   Int
  profesorId String
  profesor   Profesor @relation(fields: [profesorId], references: [id])
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Carreras que cursan esta asignatura (relación muchos a muchos).
  carreras     Carrera[]
  evaluaciones Evaluacion[]

  @@map("Asignatura")
}

model Evaluacion {
  id           String           @id @default(uuid())
  estudianteId String
  estudiante   Estudiante       @relation(fields: [estudianteId], references: [id])
  asignaturaId String
  asignatura   Asignatura       @relation(fields: [asignaturaId], references: [id])
  calificacion Int?
  estado       EstadoEvaluacion @default(PENDIENTE)
  fecha        DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Una sola evaluación resume el estado por estudiante-asignatura.
  @@unique([estudianteId, asignaturaId])
  @@map("Evaluacion")
}