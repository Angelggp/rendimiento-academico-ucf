digraph FlujoRegistrar {
  rankdir=TB;
  fontname="Helvetica";
  node [shape=box, style="rounded,filled", fillcolor="#f5f5f5", fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=11];

  N1   [label="1. Buscar estudiante"];
  N2   [shape=diamond, style=filled, fillcolor="#fff3cd", label="2. ¿Existe\nel estudiante?"];
  N3   [style=filled, fillcolor="#f8d7da", label="3. 404\n\"El estudiante no existe\""];
  N4   [label="4. Buscar asignatura"];
  N5   [shape=diamond, style=filled, fillcolor="#fff3cd", label="5. ¿Existe\nla asignatura?"];
  N6   [style=filled, fillcolor="#f8d7da", label="6. 404\n\"La asignatura no existe\""];
  N7   [shape=diamond, style=filled, fillcolor="#fff3cd", label="7. ¿Tiene permiso para\nevaluar esta asignatura?"];
  N8   [style=filled, fillcolor="#f8d7da", label="8. 403\n\"No puedes registrar\nevaluaciones de otra asignatura\""];
  N9   [shape=diamond, style=filled, fillcolor="#fff3cd", label="9. ¿La carrera del estudiante\ncursa la asignatura?"];
  N10  [style=filled, fillcolor="#f8d7da", label="10. 400\n\"El estudiante no pertenece a una\ncarrera que cursa esta asignatura\""];
  N11  [shape=diamond, style=filled, fillcolor="#fff3cd", label="11. ¿Se envió\ncalificación?"];
  N12  [shape=diamond, style=filled, fillcolor="#fff3cd", label="12. ¿La calificación es válida\n(entera y entre 0-5)?"];
  N13  [style=filled, fillcolor="#f8d7da", label="13. 400\n\"La calificación debe\nestar entre 0 y 5\""];
  N14  [shape=diamond, style=filled, fillcolor="#fff3cd", label="14. ¿calificación >= 3?"];
  N15a [style=filled, fillcolor="#d4edda", label="15a. estado = APROBADA"];
  N15b [style=filled, fillcolor="#d1ecf1", label="15b. estado = PENDIENTE"];
  N16  [style=filled, fillcolor="#d4edda", label="16. Guardar evaluación\n(upsert)"];
  Fin  [shape=doublecircle, style=filled, fillcolor="#e2e3e5", label="Fin"];

  N1 -> N2;
  N2 -> N3  [label="no"];
  N2 -> N4  [label="sí"];
  N4 -> N5;
  N5 -> N6  [label="no"];
  N5 -> N7  [label="sí"];
  N7 -> N8  [label="no"];
  N7 -> N9  [label="sí"];
  N9 -> N10 [label="no"];
  N9 -> N11 [label="sí"];
  N11 -> N12 [label="sí"];
  N11 -> N14 [label="no"];
  N12 -> N13 [label="no"];
  N12 -> N14 [label="sí"];
  N14 -> N15a [label="sí"];
  N14 -> N15b [label="no"];
  N15a -> N16;
  N15b -> N16;
  N16 -> Fin;
  N3 -> Fin;
  N6 -> Fin;
  N8 -> Fin;
  N10 -> Fin;
  N13 -> Fin;
}
