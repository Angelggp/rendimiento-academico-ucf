@startuml registrar-evaluacion
title EvaluacionesService.registrar() — diagrama de actividad

start
:1. Buscar estudiante por id;
if (2. ¿Existe el estudiante?) then (sí)
else (no)
  #Mistyrose:3. 404\n"El estudiante no existe";
  stop
endif

:4. Buscar asignatura por id;
if (5. ¿Existe la asignatura?) then (sí)
else (no)
  #Mistyrose:6. 404\n"La asignatura no existe";
  stop
endif

if (7. ¿Tiene permiso para\nevaluar esta asignatura?) then (sí)
else (no)
  #Mistyrose:8. 403\n"No puedes registrar\nevaluaciones de otra asignatura";
  stop
endif

if (9. ¿La carrera del estudiante\ncursa la asignatura?) then (sí)
else (no)
  #Mistyrose:10. 400\n"El estudiante no pertenece a una\ncarrera que cursa esta asignatura";
  stop
endif

if (11. ¿Se envió calificación\n(no undefined/null)?) then (sí)
  if (12. ¿La calificación es válida\n(entera y entre 0-5)?) then (sí)
  else (no)
    #Mistyrose:13. 400\n"La calificación debe\nestar entre 0 y 5";
    stop
  endif
else (no)
endif

if (14. ¿calificación >= 3?) then (sí)
  #Palegreen:15a. estado = APROBADA;
else (no)
  #Lightblue:15b. estado = PENDIENTE;
endif

#Palegreen:16. Guardar evaluación (upsert);
stop
@enduml
